# Copia este archivo a .env y llénalo con lo tuyo.
# .env está en el .gitignore: nunca se sube al repo.

# --- Panel de GHL / HighLevel ---
# El dominio de tu panel (el tuyo o el white-label de tu agencia)
GHL_PANEL_URL=https://app.gohighlevel.com

# locationId de la sub-cuenta con la que trabajas (lo ves en la URL: /location/<id>/...)
GHL_LOCATION_ID=

# Private Integration Token de la sub-cuenta (Settings -> Private Integrations).
# Solo para la API pública; las recetas de clonado NO lo usan (van con la sesión del navegador).
GHL_PIT=

# --- Clonado entre cuentas (opcional) ---
GHL_LOCATION_ORIGEN=
GHL_LOCATION_DESTINO=

# --- Portales con login por credenciales (opcional) ---
# Un bloque por portal. Ver references/receta-login-credenciales.md
# PORTAL_URL=
# PORTAL_USER=
# PORTAL_PASSWORD=
